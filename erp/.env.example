# --- Required ---
# Runtime connection: a NON-owner, non-superuser role so row-level security applies.
DATABASE_URL=postgresql://erp_app:CHANGE_ME@db-host:5432/ledgerline
# Migrations only (table owner). Never used by the running app.
DATABASE_OWNER_URL=postgresql://erp_owner:CHANGE_ME@db-host:5432/ledgerline
APP_URL=https://erp.example.com
# Secret for /api/cron/* (jobs, renewals). Generate with: openssl rand -hex 32
CRON_SECRET=
# --- Email (transactional) ---
SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Ledgerline <no-reply@example.com>"
# --- Subscription billing (Razorpay; use rzp_test_ keys until go-live) ---
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# GST rate applied to Ledgerline's own subscription invoices, in basis points (1800 = 18%)
PLATFORM_TAX_BPS=1800
# --- Never enable in production ---
ENABLE_DEMO_DATA=false
# BILLING_PROVIDER=test enables the built-in simulator (dev/CI only). TEST_WEBHOOK_SECRET signs its events.
TEST_WEBHOOK_SECRET=
