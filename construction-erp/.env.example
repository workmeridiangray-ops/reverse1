# --- Required ---
# Runtime connection: a NON-superuser role without BYPASSRLS (row-level security depends on it)
DATABASE_URL=postgresql://erp_app:CHANGE_ME@localhost:5432/erp
# Used only by `npm run migrate` and seed scripts: the table-owner role
DATABASE_URL_OWNER=postgresql://erp_owner:CHANGE_ME@localhost:5432/erp
APP_URL=https://app.example.com
CRON_SECRET=generate-a-long-random-string
# --- Storage / limits ---
STORAGE_DIR=/var/lib/buildline/storage     # private; mount a persistent volume and back it up
MAX_UPLOAD_MB=25
SESSION_DAYS=14
# --- Email (Resend). Without a key, mail is only logged and clearly marked as not sent. ---
RESEND_API_KEY=
MAIL_FROM="Buildline <no-reply@example.com>"
# --- Payments: PAYMENT_MODE=test (simulated, non-production only) or razorpay ---
PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# --- Demo data: keep false in production ---
ALLOW_DEMO_DATA=false
