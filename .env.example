# --- Required ---
APP_URL=https://erp.example.com
DATABASE_URL=postgres://mfg_app:CHANGE_ME@db-host:5432/mfg          # runtime role (no superuser, no BYPASSRLS)
MIGRATE_DATABASE_URL=postgres://mfg_owner:CHANGE_ME@db-host:5432/mfg # owner role, used only by `npm run migrate`
CRON_SECRET=generate-a-long-random-string                           # protects /api/cron
# --- Email (transactional) ---
EMAIL_PROVIDER=resend            # "log" keeps mail in the outbox only (dev)
EMAIL_API_KEY=
EMAIL_FROM="Forgeline <no-reply@erp.example.com>"
# --- Payments (Razorpay; use TEST keys until go-live) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# --- Development / staging only ---
ALLOW_SANDBOX_PAYMENTS=0
SANDBOX_WEBHOOK_SECRET=
# --- Storage ---
UPLOAD_DIR=/var/lib/forgeline/uploads   # private disk; back it up with the database
UPLOAD_MAX_BYTES=10000000
DB_POOL_MAX=10
