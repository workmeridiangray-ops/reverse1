# --- Database (PostgreSQL 14+) ---
# Owner connection: used ONLY by `npm run db:migrate` (creates tables, policies, the app role).
DATABASE_URL=postgresql://owner:owner-password@localhost:5432/siteledger
# Runtime connection as the non-owner `erp_app` role (subject to row-level security). Never use the owner here.
APP_DATABASE_URL=postgresql://erp_app:change-me@localhost:5432/siteledger
# Password given to erp_app by `npm run db:migrate`
ERP_APP_PASSWORD=change-me
# DB_SSL=true

# --- App ---
APP_URL=http://localhost:3000
STORAGE_DIR=./storage-data       # private file storage; mount a persistent volume in production
MAX_UPLOAD_MB=15
# INSECURE_COOKIES=true          # only for plain-http local testing of a production build

# --- Email (transactional) ---
EMAIL_MODE=log                   # log | brevo
MAIL_FROM="SiteLedger <no-reply@example.com>"
# BREVO_API_KEY=
SALES_EMAIL=sales@example.com

# --- Platform operator (created/updated by `npm run platform:admin`) ---
# PLATFORM_ADMIN_EMAIL=you@example.com
# PLATFORM_ADMIN_PASSWORD=...
