{
  "name": "tendwell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,supavisor,mailpit,storage-api,postgres-meta",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > lib/supabase/database.types.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "db:local": "bash scripts/db-reset-local.sh",
    "db:types:local": "node scripts/gen-types.mjs",
    "test:journey": "node scripts/journey.mjs",
    "test:journey2": "node scripts/journey2.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.32",
    "supabase": "^2.122.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
